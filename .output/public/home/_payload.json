003C!--#storyblok#{\"name\": \"button\", \"space\": \"145554\", \"uid\": \"221b7849-5485-46a4-8ffe-c35e75706f2e\", \"id\": \"105577320\"}-->","26489b2b-25a9-40d4-bcdd-57eac8aa9dab","A program of recovery, for men.","Structured sober living for men ready to rebuild with integrity, support, and community. Founded in 2007, Doc’s Place offers a proven path to long-term recovery in the heart of the Golden Isles.","HomepageHero",{"id":168,"alt":15,"name":15,"focus":15,"title":15,"source":15,"filename":169,"copyright":15,"fieldtype":17,"meta_data":170,"is_external_url":19},98308010600346,"https://a.storyblok.com/f/145554/1984x1155/97d74cfa06/hero-bg.jpg",{},"\u003C!--#storyblok#{\"name\": \"HomepageHero\", \"space\": \"145554\", \"uid\": \"26489b2b-25a9-40d4-bcdd-57eac8aa9dab\", \"id\": \"105577320\"}-->",{"_uid":173,"features":174,"component":206,"_editable":207},"efc09aa4-cc7b-424e-8702-acd6ad1b6f7a",[175,186,196],{"_uid":176,"icon":177,"text":178,"heading":179,"component":180,"backgroundImage":181,"_editable":185},"ed4ad465-bb81-41ab-9ff8-41b93a30a5d0","BookMarked","Our residents attend daily 12-step meetings and practice the principles of the 12-steps in their daily lives through sponsorship and mentorship.","12-Step Philosophy","feature",{"id":182,"alt":15,"name":15,"focus":15,"title":15,"source":15,"filename":183,"copyright":15,"fieldtype":17,"meta_data":184,"is_external_url":19},98397519718775,"https://a.storyblok.com/f/145554/569x354/8f06c750b7/beach.jpg",{},"\u003C!--#storyblok#{\"name\": \"feature\", \"space\": \"145554\", \"uid\": \"ed4ad465-bb81-41ab-9ff8-41b93a30a5d0\", \"id\": \"105577320\"}-->",{"_uid":187,"icon":188,"text":189,"heading":190,"component":180,"backgroundImage":191,"_editable":195},"cadc43a7-540c-4f0d-a4d8-38a7af7189cb","handshake","Our alumni call the Golden Isles home and are actively involved in Doc’s Place on a daily basis.","Community",{"id":192,"alt":15,"name":15,"focus":15,"title":15,"source":15,"filename":193,"copyright":15,"fieldtype":17,"meta_data":194,"is_external_url":19},98397627050361,"https://a.storyblok.com/f/145554/569x354/52a1f6b40e/friends.jpg",{},"\u003C!--#storyblok#{\"name\": \"feature\", \"space\": \"145554\", \"uid\": \"cadc43a7-540c-4f0d-a4d8-38a7af7189cb\", \"id\": \"105577320\"}-->",{"_uid":197,"icon":198,"text":199,"heading":200,"component":180,"backgroundImage":201,"_editable":205},"ff678ee1-18ee-4747-9c6e-87c8ed3dd868","compass","Residents are involved in local community and work full-time jobs to pay their way through our program following entry.","Responsibility",{"id":202,"alt":15,"name":15,"focus":15,"title":15,"source":15,"filename":203,"copyright":15,"fieldtype":17,"meta_data":204,"is_external_url":19},98397568792952,"https://a.storyblok.com/f/145554/569x354/68dc42ba8b/community.jpg",{},"\u003C!--#storyblok#{\"name\": \"feature\", \"space\": \"145554\", \"uid\": \"ff678ee1-18ee-4747-9c6e-87c8ed3dd868\", \"id\": \"105577320\"}-->","KeyFeatures","\u003C!--#storyblok#{\"name\": \"KeyFeatures\", \"space\": \"145554\", \"uid\": \"efc09aa4-cc7b-424e-8702-acd6ad1b6f7a\", \"id\": \"105577320\"}-->",{"_uid":209,"copy":210,"component":259,"textAlignment":260,"backgroundImage":261,"_editable":265},"f8fa885b-1b62-40b9-86da-8eb5b0f29d1e",{"type":211,"content":212},"doc",[213,227,234,239,244,249,254],{"type":214,"attrs":215,"content":216},"paragraph",{"textAlign":111},[217],{"text":218,"type":219,"marks":220},"WHY DOC'S PLACE?","text",[221,225],{"type":222,"attrs":223},"textStyle",{"color":224},"#67BF7F",{"type":226},"bold",{"type":228,"attrs":229,"content":231},"heading",{"level":230,"textAlign":111},3,[232],{"text":233,"type":219},"A FOUNDATION THAT HOLDS",{"type":214,"attrs":235,"content":236},{"textAlign":111},[237],{"text":238,"type":219},"Recovery isn't just about getting clean—it's about building something that lasts. Our program blends proven recovery principles with real-world responsibility.",{"type":228,"attrs":240,"content":241},{"level":230,"textAlign":111},[242],{"text":243,"type":219},"BUILT ON BROTHERHOOD",{"type":214,"attrs":245,"content":246},{"textAlign":111},[247],{"text":248,"type":219},"At Doc's Place, you're never alone. Our staff, residents, and alumni from a network of daily support—mentorship, friendship, and shared experience",{"type":228,"attrs":250,"content":251},{"level":230,"textAlign":111},[252],{"text":253,"type":219},"CHANGE THAT STICKS",{"type":214,"attrs":255,"content":256},{"textAlign":111},[257],{"text":258,"type":219},"We go beyond detox. Residents integrate recovery into everyday life: working full-time jobs, attending meetings, contributing to the household, and growing from the inside out.","TextImageSplit","text-left",{"id":262,"alt":15,"name":15,"focus":15,"title":15,"source":15,"filename":263,"copyright":15,"fieldtype":17,"meta_data":264,"is_external_url":19},98572020485681,"https://a.storyblok.com/f/145554/1728x659/461eb16481/bg.png",{},"\u003C!--#storyblok#{\"name\": \"TextImageSplit\", \"space\": \"145554\", \"uid\": \"f8fa885b-1b62-40b9-86da-8eb5b0f29d1e\", \"id\": \"105577320\"}-->",{"_uid":267,"text":268,"image":295,"theme":299,"button":300,"heading":307,"component":308,"_editable":309},"3c35507b-62df-4323-af21-1c9769d63685",{"type":211,"content":269},[270,293],{"type":214,"attrs":271,"content":272},{"textAlign":111},[273,278,280,281,286,287,288],{"text":274,"type":219,"marks":275},"Doc’s Place offers a secure and structured sober living environment tailored for men navigating the path to recovery from drug and alcohol dependency. Within our program, residents are presented with daily opportunities to address their psychological, spiritual, and physical well-being through structured activities that have demonstrated success in supporting men through recovery journeys.",[276],{"type":222,"attrs":277},{"color":15},{"type":279},"hard_break",{"type":279},{"text":282,"type":219,"marks":283},"Established in 2007, Doc’s Place has earned a respected reputation within the recovery community. Our program is deeply ingrained in the local community, offering a holistic approach to recovery that extends beyond mere sobriety. It's a blueprint for change, fostering happiness, joy, and freedom for those who embrace its principles.",[284],{"type":222,"attrs":285},{"color":15},{"type":279},{"type":279},{"text":289,"type":219,"marks":290},"At Doc’s Place, residents are surrounded in a supportive network that includes accomplished alumni who have found new lives through the program. Community plays a pivotal role in our program, providing an environment where individuals can thrive on their journey to recovery.",[291],{"type":222,"attrs":292},{"color":15},{"type":214,"attrs":294},{"textAlign":111},{"id":296,"alt":15,"name":15,"focus":15,"title":15,"source":15,"filename":297,"copyright":15,"fieldtype":17,"meta_data":298,"is_external_url":19},98709237510367,"https://a.storyblok.com/f/145554/584x300/0d1d8acc23/rectangle-10.png",{},"primary-outline",[301],{"_uid":302,"link":303,"theme":299,"btnText":305,"component":43,"_editable":306},"81ae848f-5f74-4f9a-b25f-b5c390dfa185",{"id":151,"url":15,"linktype":38,"fieldtype":39,"cached_url":304},"home","Take the first step","\u003C!--#storyblok#{\"name\": \"button\", \"space\": \"145554\", \"uid\": \"81ae848f-5f74-4f9a-b25f-b5c390dfa185\", \"id\": \"105577320\"}-->","Our Program","TwoColImageLeft","\u003C!--#storyblok#{\"name\": \"TwoColImageLeft\", \"space\": \"145554\", \"uid\": \"3c35507b-62df-4323-af21-1c9769d63685\", \"id\": \"105577320\"}-->",{"_uid":311,"text":312,"image":395,"theme":160,"button":399,"heading":307,"component":400,"backgroundImage":401,"_editable":405},"d53f1af4-9be5-4af0-95da-d015a57cb973",{"type":211,"content":313},[314,373],{"type":315,"content":316},"bullet_list",[317,329,340,351,362],{"type":318,"content":319},"list_item",[320],{"type":214,"attrs":321,"content":322},{"textAlign":111},[323],{"text":324,"type":219,"marks":325},"Individual counseling as needed",[326,328],{"type":222,"attrs":327},{"color":224},{"type":226},{"type":318,"content":330},[331],{"type":214,"attrs":332,"content":333},{"textAlign":111},[334],{"text":335,"type":219,"marks":336},"Individualized recovery plans",[337,339],{"type":222,"attrs":338},{"color":224},{"type":226},{"type":318,"content":341},[342],{"type":214,"attrs":343,"content":344},{"textAlign":111},[345],{"text":346,"type":219,"marks":347},"Family programming & therapy",[348,350],{"type":222,"attrs":349},{"color":224},{"type":226},{"type":318,"content":352},[353],{"type":214,"attrs":354,"content":355},{"textAlign":111},[356],{"text":357,"type":219,"marks":358},"Structured activities & group learning opportunities dictated by residents",[359,361],{"type":222,"attrs":360},{"color":224},{"type":226},{"type":318,"content":363},[364],{"type":214,"attrs":365,"content":366},{"textAlign":111},[367],{"text":368,"type":219,"marks":369},"Weekly & on-the-spot drug testing",[370,372],{"type":222,"attrs":371},{"color":224},{"type":226},{"type":214,"attrs":374,"content":375},{"textAlign":111},[376,381,382,383,388,389,390],{"text":377,"type":219,"marks":378},"Residents at Doc’s Place actively participate in a 12-Step program, adhere to the program's rules and guidelines, and benefit from round-the-clock accountability provided by our dedicated staff, alumni, and senior residents. We offer a working program where residents are expected to pay their own way by securing full-time employment within the local community.",[379],{"type":222,"attrs":380},{"color":15},{"type":279},{"type":279},{"text":384,"type":219,"marks":385},"For over 17 years, Doc’s Place has been a source of long-term structured support for individuals struggling with alcoholism and substance addiction. Our alumni play an integral role in the ongoing success of Doc’s Place and participate through sponsorship, mentoring, and attendance to group events and activities.",[386],{"type":222,"attrs":387},{"color":15},{"type":279},{"type":279},{"text":391,"type":219,"marks":392},"Recognizing that each resident is a unique individual with distinct needs, our staff conducts bi-weekly reviews to assess and address those needs. We operate as a cohesive team, ensuring that residents receive personalized support on a daily basis, paving the way for them to achieve lasting sobriety and success beyond their time at Doc’s Place.",[393],{"type":222,"attrs":394},{"color":15},{"id":396,"alt":15,"name":15,"focus":15,"title":15,"source":15,"filename":397,"copyright":15,"fieldtype":17,"meta_data":398,"is_external_url":19},98717937586716,"https://a.storyblok.com/f/145554/594x351/240ca1b83c/golf-group.png",{},[],"TwoColImageRight",{"id":402,"alt":15,"name":15,"focus":15,"title":15,"source":15,"filename":403,"copyright":15,"fieldtype":17,"meta_data":404,"is_external_url":19},98723436388922,"https://a.storyblok.com/f/145554/1730x524/1bcc06dc9f/content-bg.jpg",{},"\u003C!--#storyblok#{\"name\": \"TwoColImageRight\", \"space\": \"145554\", \"uid\": \"d53f1af4-9be5-4af0-95da-d015a57cb973\", \"id\": \"105577320\"}-->",{"_uid":407,"text":408,"button":409,"component":415,"headingSize":416,"background_image":417,"_editable":419},"bba6e9ec-158b-42c0-bc00-4ace1f28d115","If you do what you’ve always done,\nyou’ll get what you’ve always gotten",[410],{"_uid":411,"link":412,"theme":41,"btnText":413,"component":43,"_editable":414},"d12dcc89-4b52-4b42-b8fa-6ca2d16d1bce",{"id":37,"url":15,"linktype":38,"fieldtype":39,"cached_url":40},"Start Your Recovery","\u003C!--#storyblok#{\"name\": \"button\", \"space\": \"145554\", \"uid\": \"d12dcc89-4b52-4b42-b8fa-6ca2d16d1bce\", \"id\": \"105577320\"}-->","CallToAction","large",{"id":182,"alt":15,"name":15,"focus":15,"title":15,"source":15,"filename":183,"copyright":15,"fieldtype":17,"meta_data":418,"is_external_url":19},{},"\u003C!--#storyblok#{\"name\": \"CallToAction\", \"space\": \"145554\", \"uid\": \"bba6e9ec-158b-42c0-bc00-4ace1f28d115\", \"id\": \"105577320\"}-->",{"_uid":421,"icon":422,"image":423,"title":427,"button":428,"content":433,"component":471,"_editable":472},"d17efe90-fe38-4f29-95f4-1a765b9daf1e","house",{"id":424,"alt":15,"name":15,"focus":15,"title":15,"source":15,"filename":425,"copyright":15,"fieldtype":17,"meta_data":426,"is_external_url":19},98928760814443,"https://a.storyblok.com/f/145554/1887x983/84c3becc5b/beach.jpg",{},"Accommodations & Living",[429],{"_uid":430,"link":431,"theme":299,"btnText":305,"component":43,"_editable":432},"314f878f-a902-42c4-bd9a-9eca7d68d922",{"id":151,"url":15,"linktype":38,"fieldtype":39,"cached_url":304},"\u003C!--#storyblok#{\"name\": \"button\", \"space\": \"145554\", \"uid\": \"314f878f-a902-42c4-bd9a-9eca7d68d922\", \"id\": \"105577320\"}-->",{"type":211,"content":434},[435],{"type":214,"attrs":436,"content":437},{"textAlign":111},[438,443,444,445,450,451,452,457,458,459,464,465,470],{"text":439,"type":219,"marks":440},"Our residences are crafted to provide residents with a sense of comfort and belonging within a vibrant community. Our primary location boasts over 6,200 square feet, featuring five spacious suites. Each suite is equipped with a full kitchen, two to three bedrooms, and at least one full bath.",[441],{"type":222,"attrs":442},{"color":15},{"type":279},{"type":279},{"text":446,"type":219,"marks":447},"Residents enjoy a variety of communal spaces, including game rooms, a serene wrap-around porch shaded by live oak trees, fenced private yards, dedicated exercise areas, and cozy living rooms furnished with comfortable seating and entertainment systems. Additional amenities across our properties include Wi-Fi access, Ping-Pong and pool tables, access to expansive outdoor parks just steps away, and an outdoor BBQ patio.",[448],{"type":222,"attrs":449},{"color":15},{"type":279},{"type":279},{"text":453,"type":219,"marks":454},"Located near the beach and conveniently situated within walking distance of several waterfronts and downtown areas, Doc’s Place offers residents easy access to a host of recreational activities. From kayaking and fishing to surfing and golf, our residents have access to a wide array of outdoor equipment to enjoy their leisure time.",[455],{"type":222,"attrs":456},{"color":15},{"type":279},{"type":279},{"text":460,"type":219,"marks":461},"To ensure a supportive and compliant living environment, resident staff members are present at each facility, overseeing adherence to Doc’s Place policies and procedures. Chores and household responsibilities are shared among residents, fostering a sense of communal living.",[462],{"type":222,"attrs":463},{"color":15},{"type":279},{"text":466,"type":219,"marks":467},"At Doc’s Place, residents have the autonomy to make weekly food choices tailored to their preferences, collaborating on shopping lists to meet their individual needs. Our goal is to create an environment where residents can thrive on their journey to recovery.",[468],{"type":222,"attrs":469},{"color":15},{"type":279},"FeaturedContent","\u003C!--#storyblok#{\"name\": \"FeaturedContent\", \"space\": \"145554\", \"uid\": \"d17efe90-fe38-4f29-95f4-1a765b9daf1e\", \"id\": \"105577320\"}-->",{"_uid":474,"title":475,"content":476,"component":503,"_editable":504},"7a58499b-69ba-46f8-8884-2d5ecafda204","Frequently Asked Questions",[477,483,488,493,498],{"_uid":478,"answer":479,"question":480,"component":481,"_editable":482},"6f653d6a-9837-4e6b-b8bb-478ac0c18786","A long-term structured sober living program for men recovering from substance abuse","What is Doc’s Place?","faq","\u003C!--#storyblok#{\"name\": \"faq\", \"space\": \"145554\", \"uid\": \"6f653d6a-9837-4e6b-b8bb-478ac0c18786\", \"id\": \"105577320\"}-->",{"_uid":484,"answer":485,"question":486,"component":481,"_editable":487},"dd43435d-3ad3-4b71-b348-c88a96f6cb23","It varies by individual needs. Most residents stay between 6-12 months","How long is the program?","\u003C!--#storyblok#{\"name\": \"faq\", \"space\": \"145554\", \"uid\": \"dd43435d-3ad3-4b71-b348-c88a96f6cb23\", \"id\": \"105577320\"}-->",{"_uid":489,"answer":490,"question":491,"component":481,"_editable":492},"87cede29-83dc-42c1-8d72-38dc13831be5","Yes. Residents are expected to secure full-time employment and pay rent—building both ownership and dignity.","Do residents pay to stay?","\u003C!--#storyblok#{\"name\": \"faq\", \"space\": \"145554\", \"uid\": \"87cede29-83dc-42c1-8d72-38dc13831be5\", \"id\": \"105577320\"}-->",{"_uid":494,"answer":495,"question":496,"component":481,"_editable":497},"403dbe6b-b690-4a11-9aed-3a38527cb114","No. We are not a clinical treatment center, but we can refer individuals to trusted providers prior to entry.","Do you offer detox or medical services?","\u003C!--#storyblok#{\"name\": \"faq\", \"space\": \"145554\", \"uid\": \"403dbe6b-b690-4a11-9aed-3a38527cb114\", \"id\": \"105577320\"}-->",{"_uid":499,"answer":500,"question":501,"component":481,"_editable":502},"cc0981fc-45d8-4557-ae60-1c52c988af07","Doc's place follows a 12-step model grounded in spiritual growth, not any specific religious doctrine.","Is this a faith-based program?","\u003C!--#storyblok#{\"name\": \"faq\", \"space\": \"145554\", \"uid\": \"cc0981fc-45d8-4557-ae60-1c52c988af07\", \"id\": \"105577320\"}-->","FrequentlyAskedQuestions","\u003C!--#storyblok#{\"name\": \"FrequentlyAskedQuestions\", \"space\": \"145554\", \"uid\": \"7a58499b-69ba-46f8-8884-2d5ecafda204\", \"id\": \"105577320\"}-->",{"_uid":506,"quote":507,"author":508,"component":509,"backgroundImage":510,"_editable":514},"f8836b89-9cec-41c8-a505-1d3e15904392","They have a great reputation as far as clients maintaining long term recovery. The staff is very helpful and knowledgeable. They hold their clients accountable, and create an environment that made me feel hopeful... They showed me that life in recovery was full of possibilities!","– Steven K, Docs Place Alumni","Quote",{"id":511,"alt":15,"name":15,"focus":15,"title":15,"source":15,"filename":512,"copyright":15,"fieldtype":17,"meta_data":513,"is_external_url":19},99120808751531,"https://a.storyblok.com/f/145554/1805x586/928d7fb310/porch-hangs.jpg",{},"\u003C!--#storyblok#{\"name\": \"Quote\", \"space\": \"145554\", \"uid\": \"f8836b89-9cec-41c8-a505-1d3e15904392\", \"id\": \"105577320\"}-->","Page","\u003C!--#storyblok#{\"name\": \"Page\", \"space\": \"145554\", \"uid\": \"d4074c14-1f77-449c-9f08-cae8c047a20c\", \"id\": \"105577320\"}-->",[],"e7106631-d7ba-4dc9-9f1c-10bfea885720","2022-02-07T15:31:52.000Z","/",[],[],[],{"cache-control":123,"connection":124,"content-encoding":125,"content-type":126,"date":525,"etag":526,"referrer-policy":129,"sb-be-version":130,"server":131,"transfer-encoding":132,"vary":133,"via":527,"x-amz-cf-id":528,"x-amz-cf-pop":136,"x-cache":529,"x-content-type-options":138,"x-frame-options":139,"x-permitted-cross-domain-policies":140,"x-request-id":530,"x-runtime":531,"x-xss-protection":143},"Fri, 10 Oct 2025 21:36:48 GMT","W/\"a8f58354ee67a41ea67dfbb5d9e0433d\"","1.1 a849aab265796f3b1c80dee87a056b44.cloudfront.net (CloudFront)","i0udWo79gDk-UuV05mWx2dvsLPJVSFfcQFYuTGu0rVw-aVhDngScVw==","RefreshHit from cloudfront","d00c7193-ede1-495e-9c9d-41ce477f1c06","0.030087",1760132207698]