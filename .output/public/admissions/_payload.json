9317-bdfe-42fa-8a85-ec1f1c06a9b0","2022-02-07T15:32:12.461Z","default",[],1760100416,[],[],{"cache-control":123,"connection":124,"content-encoding":125,"content-type":126,"date":127,"etag":128,"referrer-policy":129,"sb-be-version":130,"server":131,"transfer-encoding":132,"vary":133,"via":134,"x-amz-cf-id":135,"x-amz-cf-pop":136,"x-cache":137,"x-content-type-options":138,"x-frame-options":139,"x-permitted-cross-domain-policies":140,"x-request-id":141,"x-runtime":142,"x-xss-protection":143},"max-age=0, private, must-revalidate","keep-alive","gzip","application/json; charset=utf-8","Fri, 10 Oct 2025 21:36:47 GMT","W/\"171a3cb91ee1061b1dd7dcddc156d8a2\"","strict-origin-when-cross-origin","5.79.1","nginx/1.29.1","chunked","Origin,accept-encoding","1.1 f0d2db130f25377126d8fc517e82fa4c.cloudfront.net (CloudFront)","nfG8A1TzpRS9S42rN1g-oxJ_h0HgAdXMgFVlXYbGXaC0oSCycxuC7w==","MIA3-C1","Hit from cloudfront","nosniff","SAMEORIGIN","none","ab1fc2cb-fcd2-4308-b8ee-83bd9f976270","0.024830","0",{"data":145,"headers":268},{"story":146,"cv":119,"rels":266,"links":267},{"name":61,"created_at":147,"published_at":148,"updated_at":149,"id":150,"uuid":59,"content":151,"slug":60,"full_slug":60,"sort_by_date":111,"position":261,"tag_list":262,"is_startpage":19,"parent_id":114,"meta_data":111,"group_id":263,"first_published_at":264,"release_id":111,"lang":117,"path":111,"alternates":265,"default_full_slug":111,"translated_slugs":111},"2022-02-04T04:34:37.163Z","2022-03-08T03:46:01.986Z","2022-03-08T03:46:02.001Z",105578054,{"_uid":152,"body":153,"component":259,"_editable":260},"7132f511-2dc9-4a7c-982a-e818d44b61b6",[154,160,209,214,239],{"_uid":155,"text":156,"heading":157,"component":158,"_editable":159},"04c8bb8f-ccc9-4017-aa34-904f43f30666","To be accepted into Doc’s Place residents must commit to a minimum of 6 months length stay with the understanding that program completion requires at least 1 year stay.","Admission Requirements","PageTitle","\u003C!--#storyblok#{\"name\": \"PageTitle\", \"space\": \"145554\", \"uid\": \"04c8bb8f-ccc9-4017-aa34-904f43f30666\", \"id\": \"105578054\"}-->",{"_uid":161,"text":162,"image":201,"theme":205,"button":206,"heading":15,"component":207,"_editable":208},"17e3d9a0-826a-4b52-9a72-97518ed11ad9",{"type":163,"content":164},"doc",[165,171,175,179],{"type":166,"content":167},"paragraph",[168],{"text":169,"type":170},"An entry fee of $3,500.00 is due upon admission into Doc’s Place, to be paid by support network or the resident himself. Entry fee includes the resident’s first four weeks (first month) rent, groceries, and utilities.","text",{"type":166,"content":172},[173],{"text":174,"type":170},"The resident’s entry fee also covers all costs related to Group Therapy, led by a fully licensed clinician; the resident incurs no extra costs for this service the remainder of his stay. After the first 3-14 days residents start full time employment, depending on the individuals.",{"type":166,"content":176},[177],{"text":178,"type":170},"After the expiration of the initial four-week period, rent and groceries are paid on a weekly basis by the resident himself. Rent and grocery monies are to be paid in advance on this basis, although alternative arrangements may be discussed on an individual basis. As the resident progresses through the program rent starts to decrease to assist residents with transitioning into the community. The payment schedule is as follows:",{"type":180,"content":181},"bullet_list",[182,189,195],{"type":183,"content":184},"list_item",[185],{"type":166,"content":186},[187],{"text":188,"type":170},"1-9 months: $160 due weekly",{"type":183,"content":190},[191],{"type":166,"content":192},[193],{"text":194,"type":170},"9-12 months: $125 due weekly",{"type":183,"content":196},[197],{"type":166,"content":198},[199],{"text":200,"type":170},"12+ months: $100 due weekly",{"id":202,"alt":203,"name":15,"focus":111,"title":15,"filename":204,"copyright":15,"fieldtype":17},3856038,"A group of men pose in front of the Docs Place house","https://a.storyblok.com/f/145554/1440x1440/fe1c51e321/69ddb658-a8cf-48f8-b300-e82a0d958165-1.jpg","primary",[],"TwoColImageLeft","\u003C!--#storyblok#{\"name\": \"TwoColImageLeft\", \"space\": \"145554\", \"uid\": \"17e3d9a0-826a-4b52-9a72-97518ed11ad9\", \"id\": \"105578054\"}-->",{"_uid":210,"text":211,"component":212,"_editable":213},"d09f19e9-0cec-4af1-90e8-4553f65d7a5c","Before acceptance into the program prospective residents must be physically, mentally, emotionally, and behaviorally capable of functioning in a residential setting and must not present a danger to himself or others in any capacity.","HighlightText","\u003C!--#storyblok#{\"name\": \"HighlightText\", \"space\": \"145554\", \"uid\": \"d09f19e9-0cec-4af1-90e8-4553f65d7a5c\", \"id\": \"105578054\"}-->",{"_uid":215,"images":216,"component":237,"_editable":238},"11cb210e-baf9-48f6-be90-5a9f4d2cdd3c",[217,221,225,229,233],{"id":218,"alt":219,"name":15,"focus":111,"title":111,"filename":220,"copyright":111,"fieldtype":17},3982221,"4 men kayaking","https://a.storyblok.com/f/145554/1511x676/f4d098b655/img_2234-1.jpg",{"id":222,"alt":223,"name":15,"focus":111,"title":111,"filename":224,"copyright":111,"fieldtype":17},3982224,"A group of men attending Doc's Place on the porch.","https://a.storyblok.com/f/145554/2048x1536/466a4dc7ca/img_3113.JPEG",{"id":226,"alt":227,"name":15,"focus":111,"title":111,"filename":228,"copyright":111,"fieldtype":17},3982220,"3 men smile for the camera on a golf course.","https://a.storyblok.com/f/145554/960x720/ffdd47025d/img_1053.JPG",{"id":230,"alt":231,"name":15,"focus":111,"title":111,"filename":232,"copyright":111,"fieldtype":17},3982223,"A group of men pause for a photo at a water park.","https://a.storyblok.com/f/145554/2048x1536/c0538eddab/img_2994-2.JPEG",{"id":234,"alt":235,"name":15,"focus":111,"title":111,"filename":236,"copyright":111,"fieldtype":17},3982222,"A group of men getting ready to go paddle boarding.","https://a.storyblok.com/f/145554/2048x1536/681680ebd8/img_2888.JPEG","Carousel","\u003C!--#storyblok#{\"name\": \"Carousel\", \"space\": \"145554\", \"uid\": \"11cb210e-baf9-48f6-be90-5a9f4d2cdd3c\", \"id\": \"105578054\"}-->",{"_uid":240,"text":241,"image":251,"theme":41,"button":255,"heading":256,"component":257,"_editable":258},"b31d830b-54e6-42b9-966e-4931a546b613",{"type":163,"content":242},[243,247],{"type":166,"content":244},[245],{"text":246,"type":170},"Residents must be medically stable prior to acceptance into the program. Any individual with ongoing medical problems, including dual diagnoses, may be accepted into Doc’s Place on an individual basis. Residents accepted with dual diagnosis are responsible for addressing their needs with outside professional help, including medication management.",{"type":166,"content":248},[249],{"text":250,"type":170},"Doc’s Place will assist with appropriate referrals, when necessary, but it is solely the resident’s responsibility to pay for and maintain such professional help.",{"id":252,"alt":253,"name":15,"focus":111,"title":15,"filename":254,"copyright":15,"fieldtype":17},3856039,"A few men around a table filled with food.","https://a.storyblok.com/f/145554/2048x1536/414ba9b519/img_2391-1.jpeg",[],"Prior to entry resident must have abstained from alcohol and/or drug use for at least twenty-four hours immediately preceding admission to the program of Doc’s Place. In most cases residents will be required to complete detox prior to acceptance into our facility. We are happy to refer residents to reputable detox facilities within driving distance.","TwoColImageRight","\u003C!--#storyblok#{\"name\": \"TwoColImageRight\", \"space\": \"145554\", \"uid\": \"b31d830b-54e6-42b9-966e-4931a546b613\", \"id\": \"105578054\"}-->","Page","\u003C!--#storyblok#{\"name\": \"Page\", \"space\": \"145554\", \"uid\": \"7132f511-2dc9-4a7c-982a-e818d44b61b6\", \"id\": \"105578054\"}-->",-50,[],"6dd8a82a-9312-400d-9653-ec8c46a1bcc0","2022-02-07T15:32:27.415Z",[],[],[],{"cache-